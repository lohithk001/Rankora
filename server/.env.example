# ==============================================================================
# RANKORA PRODUCTION BACKEND ENVIRONMENT CONFIGURATION (GO + GIN + NEON)
# ==============================================================================
# Copy this file to .env and configure with your real credentials.
# NEVER commit .env to source control or expose secret keys in client-side code.

# Server & Network Configuration
PORT=8080
API_HOST=0.0.0.0
APP_ENV=development # 'development', 'staging', or 'production'
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated list of trusted client origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Neon Serverless PostgreSQL Connection String
# Obtain pooled connection string from Neon Console (https://console.neon.tech)
# Example: postgresql://USER:PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Direct connection for schema migrations (bypasses pgbouncer connection pooler)
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Database Connection Pool Tuning
DB_MAX_CONNS=25
DB_MIN_CONNS=4
DB_MAX_CONN_LIFETIME_MINUTES=30
DB_MAX_CONN_IDLE_MINUTES=5
DB_HEALTH_TIMEOUT_SECONDS=5

# Clerk Authentication Settings
# Use your project's Frontend API JWKS endpoint for public key discovery & rotation:
# Example: https://clerk.yourdomain.com/.well-known/jwks.json
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_ISSUER=https://clerk.yourdomain.com
CLERK_SECRET_KEY=sk_live_...
CLERK_PEM_PUBLIC_KEY=

# GitHub OAuth Integration (Developer Repository Intelligence)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/integrations/github/callback

# Security & Symmetric Token Encryption (AES-256-GCM)
# 32-byte secret passphrase used for encrypting external provider tokens in Neon
TOKEN_ENCRYPTION_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Rate Limiting & Protection
RATE_LIMIT_DURATION=15m
RATE_LIMIT_MAX_REQUESTS=300
REQUEST_TIMEOUT=30s
